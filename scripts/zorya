#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2025 Ledger https://www.ledger.com - INSTITUT MINES TELECOM
#
# SPDX-License-Identifier: Apache-2.0

##############################################################################
#                             Z O R Y A  wrapper
#   Interactive by default – but any missing info can be supplied via flags.
##############################################################################

RESET="\033[0m"; BOLD="\033[1m"; CYAN="\033[36m"; GREEN="\033[32m"

print_banner() {
  cat << 'EOF'
███████╗ ██████╗ ██████╗ ██╗   ██╗ █████╗ 
╚══███╔╝██╔═══██╗██╔══██╗╚██╗ ██╔╝██╔══██╗
  ███╔╝ ██║   ██║██████╔╝ ╚████╔╝ ███████║
 ███╔╝  ██║   ██║██╔══██╗  ╚██╔╝  ██╔══██║
███████╗╚██████╔╝██║  ██║   ██║   ██║  ██║
╚══════╝ ╚═════╝ ╚═╝  ╚═╝   ╚═╝   ╚═╝  ╚═╝
EOF
  echo -e "    ${CYAN}${BOLD}Next Generation Concolic Analysis${RESET}"
}
divider() { echo -e "${CYAN}*************************************************************************************${RESET}"; }

##############################################################################
#                         INSTALL-TIME PATHS
##############################################################################
# _ZORYA_EMBED is replaced by `make install` (and the Dockerfile) with the
# checkout path used at build/install time.  In a pristine clone it stays
# "__ZORYA_DIR__" and we discover the checkout from $ZORYA_DIR env or from
# the location of this script (scripts/zorya -> parent directory).
_ZORYA_EMBED="__ZORYA_DIR__"

is_valid_zorya_root() {
  [[ -n "$1" ]] && [[ -f "$1/Cargo.toml" ]] && [[ -d "$1/external/pcode-generator" ]]
}

resolve_zorya_dir() {
  if is_valid_zorya_root "${ZORYA_DIR:-}"; then
    return 0
  fi

  if [[ "${_ZORYA_EMBED}" != "__ZORYA_DIR__" ]] && is_valid_zorya_root "${_ZORYA_EMBED}"; then
    ZORYA_DIR="${_ZORYA_EMBED}"
    export ZORYA_DIR
    return 0
  fi

  local script_path script_dir candidate
  script_path="${BASH_SOURCE[0]}"
  if [[ -L "${script_path}" ]]; then
    script_path="$(readlink -f "${script_path}")" || script_path="${BASH_SOURCE[0]}"
  fi
  script_dir="$(cd "$(dirname "${script_path}")" && pwd)" || exit 1
  candidate="$(cd "${script_dir}/.." && pwd)" || exit 1

  if [[ "$(basename "${script_dir}")" == "scripts" ]] && is_valid_zorya_root "${candidate}"; then
    ZORYA_DIR="${candidate}"
    export ZORYA_DIR
    return 0
  fi

  echo "zorya: could not locate Zorya checkout root."
  echo "  Set ZORYA_DIR to the directory containing Cargo.toml and external/pcode-generator,"
  echo "  run this wrapper from scripts/zorya inside a clone,"
  echo "  reinstall via make install from the checkout,"
  echo "  or rely on MCP: zorya-mcp sets ZORYA_DIR so spawned runs inherit it."
  exit 1
}

resolve_zorya_dir
unset _ZORYA_EMBED

PCODE_GENERATOR_DIR="$ZORYA_DIR/external/pcode-generator"
INIT_DATA_DIR="$ZORYA_DIR/results/initialization_data"
[[ ! -d "$PCODE_GENERATOR_DIR" ]] && { echo "Missing pcode-generator – run make all"; exit 1; }
mkdir -p "$INIT_DATA_DIR"

# ── Trace file setup ────────────────────────────────────────────────────────
# Truncate execution_trace.txt at the very start of each run, then redirect
# ALL terminal output (stdout + stderr) through `tee` so that every line
# printed to the terminal — including pcode generation, GDB dumps, VDSO
# extraction, and the Rust binary's own output — is also captured in the
# trace file in the correct chronological order.
#
# The Rust binary detects ZORYA_TRACE_BY_SHELL=1 and switches to
# stdout-only loggers so it does NOT write directly to the file (which
# would create duplicate lines alongside the ones tee writes).
TRACE_FILE="$ZORYA_DIR/results/execution_trace.txt"
mkdir -p "$ZORYA_DIR/results"
> "$TRACE_FILE"                                         # truncate / create
export ZORYA_TRACE_BY_SHELL=1
# Tee all output (stdout + stderr) to the trace file, stripping ANSI colour
# escape sequences so the file contains plain text while the terminal still
# sees colours.  The sed pattern matches ESC [ … <letter> (SGR, cursor, etc.)
exec > >(tee >(sed 's/\x1b\[[0-9;]*[A-Za-z]//g' >> "$TRACE_FILE")) 2>&1

##############################################################################
#                         HELPER FUNCTIONS
##############################################################################

# Get the binary entry point using readelf
get_entry_point() {
  readelf -h "$1" | awk '/Entry point address:/ {print $NF}'
}

# Try to find the Go or C-style main symbol address
get_main_addr() {
  nm "$1" | awk '
    / main.main$/     {print "0x"$1; found=1; exit}
    / main$/          {m="0x"$1}
    END { if (!found && m) print m }'
}

##############################################################################
#                         BASIC ARG PARSER
##############################################################################

# Binary must be provided as the first argument
if [[ -z "$1" || "$1" == -* ]]; then
  echo -e "${CYAN}${BOLD}Zorya - Next Generation Concolic Analysis${RESET}"
  echo ""
  echo -e "${BOLD}Usage:${RESET}"
  echo -e "  zorya ${GREEN}<binary>${RESET} [options]"
  echo ""
  echo -e "${BOLD}Options:${RESET}"
  echo -e "  ${GREEN}--lang${RESET} <go|c|c++>              Source language of the binary"
  echo -e "  ${GREEN}--compiler${RESET} <tinygo|gc>         Go compiler used (required for Go binaries)"
  echo -e "  ${GREEN}--mode${RESET} <start|main|function|advanced> [addr]"
  echo -e "                                  Analysis starting point"
  echo -e "  ${GREEN}--thread-scheduling${RESET} <all-threads|main-only>"
  echo -e "                                  Thread scheduling strategy (Go GC, C, C++)"
  echo -e "  ${GREEN}--arg${RESET} <args...>               Binary arguments"
  echo -e "  ${GREEN}--symbolic-registers${RESET} <regs>   (Advanced) Registers to make symbolic (e.g. \"RAX RDI\")"
  echo -e "  ${GREEN}--no-symbolic-registers${RESET}      (Advanced) Skip symbolic registers (no prompt)"
  echo -e "  ${GREEN}--symbolic-memory${RESET} <ranges>    (Advanced) Memory ranges: \"0xADDR:SIZE ...\" "
  echo -e "  ${GREEN}--no-symbolic-memory${RESET}          (Advanced) Skip symbolic memory (no prompt)"
  echo -e "  ${GREEN}--negate-path-exploration${RESET}     Enable path negation (default: yes)"
  echo -e "  ${GREEN}--no-negate-path-exploration${RESET}  Disable path negation"
  echo -e "  ${GREEN}--plugin${RESET} <\"plugin1 plugin2\"|all|none>"
  echo -e "                                  Plugins to activate (volos, toctou, chancheck, all, none)"
  echo -e "  ${GREEN}--force-pty${RESET}                   Run GDB inside a PTY (makes the target"
  echo -e "                                  process see a real terminal, e.g. for Go's"
  echo -e "                                  isatty checks in kubectl)"
  echo ""
  echo -e "${BOLD}Examples:${RESET}"
  echo -e "  zorya ./myprogram --lang go --compiler tinygo --mode main --arg \"input\""
  echo -e "  zorya /path/to/binary --lang c --mode function 0x401000"
  echo -e "  zorya /path/to/binary --lang go --mode advanced 0x401000 --symbolic-registers \"RAX RDI\" --no-symbolic-memory"
  echo -e "  zorya /path/to/binary --lang go --compiler gc --mode main --plugin \"volos toctou\""
  echo ""
  exit 1
fi

BIN_PATH_ORIGINAL="$1"; shift || true

# Check if binary exists first
if [[ ! -f "$BIN_PATH_ORIGINAL" ]]; then
  echo "Error: Binary file not found: $BIN_PATH_ORIGINAL"
  exit 1
fi

# Convert to absolute path so it works even after we cd to different directories
BIN_PATH="$(cd "$(dirname "$BIN_PATH_ORIGINAL")" && pwd)/$(basename "$BIN_PATH_ORIGINAL")"

# Initialize variables
SOURCE_LANG=""
COMPILER=""
MODE=""
ADDR=""
ARGS="none"
ARGS_SET=false
NEGATE_PATH_FLAG=""
THREAD_SCHEDULING=""
FORCE_PTY="false"
SYMBOLIC_REGISTERS=""
SYMBOLIC_MEMORY=""
PLUGINS=""

# Argument parsing loop
while [[ $# -gt 0 ]]; do
  case "$1" in
    --lang)
      SOURCE_LANG="$2"; shift 2 ;;
    --compiler)
      COMPILER="$2"; shift 2 ;;
    --thread-scheduling)
      THREAD_SCHEDULING="$2"; shift 2 ;;
    --mode)
      MODE="$2"; shift 2
      # Accept an address for *any* mode (main/function/advanced)
      if [[ $# -gt 0 && "$1" != "--"* && "$1" =~ ^0x[0-9a-fA-F]+$ ]]; then
        ADDR="$1"; shift
      fi
      ;;
    --force-pty)
      FORCE_PTY="true"; shift ;;
    --symbolic-registers)
      SYMBOLIC_REGISTERS="$2"; shift 2 ;;
    --no-symbolic-registers)
      SYMBOLIC_REGISTERS="none"; shift ;;
    --symbolic-memory)
      SYMBOLIC_MEMORY="$2"; shift 2 ;;
    --no-symbolic-memory)
      SYMBOLIC_MEMORY="none"; shift ;;
    --negate-path-exploration|--negate)
      NEGATE_PATH_FLAG="true"; shift ;;
    --no-negate-path-exploration|--no-negate)
      NEGATE_PATH_FLAG="false"; shift ;;
    --plugin)
      PLUGINS="$2"; shift 2
      VALID_PLUGINS="none volos toctou chancheck all"
      for p in $PLUGINS; do
        if ! echo "$VALID_PLUGINS" | grep -qw "$p"; then
          echo "ERROR: Unknown plugin '$p'. Valid options: $VALID_PLUGINS"
          exit 1
        fi
      done
      ;;
    --arg)
      ARGS_SET=true
      ARGS=""
      shift
      while [[ $# -gt 0 ]]; do
        if [[ "$1" == --* ]]; then
          break
        else
          if [[ -z "$ARGS" ]]; then
            ARGS="$1"
          else
            ARGS="$ARGS $1"
          fi
          shift
        fi
      done
      [[ -z "$ARGS" ]] && ARGS="none"
      ;;
    --help|-h)
      echo -e "${CYAN}${BOLD}Zorya - Next Generation Concolic Analysis${RESET}"
      echo ""
      echo -e "${BOLD}Usage:${RESET}"
      echo -e "  zorya ${GREEN}<binary>${RESET} [options]"
      echo ""
      echo -e "${BOLD}Options:${RESET}"
      echo -e "  ${GREEN}--lang${RESET} <go|c|c++>              Source language of the binary"
      echo -e "  ${GREEN}--compiler${RESET} <tinygo|gc>         Go compiler used (required for Go binaries)"
      echo -e "  ${GREEN}--mode${RESET} <start|main|function|advanced> [addr]"
      echo -e "                                  Analysis starting point"
      echo -e "  ${GREEN}--thread-scheduling${RESET} <all-threads|main-only>"
      echo -e "                                  Thread scheduling strategy (Go GC only)"
      echo -e "  ${GREEN}--arg${RESET} <args...>               Binary arguments"
      echo -e "  ${GREEN}--symbolic-registers${RESET} <regs>   (Advanced) Registers to make symbolic"
      echo -e "  ${GREEN}--no-symbolic-registers${RESET}      (Advanced) Skip symbolic registers (no prompt)"
      echo -e "  ${GREEN}--symbolic-memory${RESET} <ranges>    (Advanced) Memory ranges: \"0xADDR:SIZE ...\""
      echo -e "  ${GREEN}--no-symbolic-memory${RESET}          (Advanced) Skip symbolic memory (no prompt)"
      echo -e "  ${GREEN}--negate-path-exploration${RESET}     Enable path negation (default: yes)"
      echo -e "  ${GREEN}--no-negate-path-exploration${RESET}  Disable path negation"
      echo -e "  ${GREEN}--plugin${RESET} <\"plugin1 plugin2\"|all|none>"
      echo -e "                                  Plugins to activate (volos, toctou, chancheck, all, none)"
      echo -e "  ${GREEN}--force-pty${RESET}                   Run GDB inside a PTY (makes the target"
      echo -e "                                  process see a real terminal)"
      echo -e "  ${GREEN}--help${RESET}, ${GREEN}-h${RESET}                    Show this help message"
      echo ""
      echo -e "${BOLD}Examples:${RESET}"
      echo -e "  zorya ./myprogram --lang go --compiler tinygo --mode main --arg \"input\""
      echo -e "  zorya /path/to/binary --lang c --mode function 0x401000"
      echo -e "  zorya /path/to/binary --lang go --mode advanced 0x401000 --symbolic-registers \"RAX RDI\" --no-symbolic-memory"
      echo -e "  zorya /path/to/binary --lang go --compiler gc --mode main --plugin \"volos toctou\""
      echo ""
      exit 0
      ;;
    *)
      echo "Unknown flag: $1"; exit 1 ;;
  esac
done

##############################################################################
#                        INTERACTIVE QUESTIONS (fallback)
##############################################################################

INTERACTIVE_MODE=false
[[ -z "$SOURCE_LANG" || -z "$MODE" || "$ARGS_SET" == "false" || -z "$NEGATE_PATH_FLAG" || -z "$PLUGINS" ]] && INTERACTIVE_MODE=true
[[ "${SOURCE_LANG,,}" == "go" && -z "$COMPILER" ]] && INTERACTIVE_MODE=true

if [[ "$INTERACTIVE_MODE" == "true" ]]; then
  echo ""
  print_banner
else
  echo ""
  echo -e "${CYAN}${BOLD}ZORYA - Next Generation Concolic Analysis${RESET}"
fi

# 0. Language
if [[ -z "$SOURCE_LANG" ]]; then
  echo ""; echo "What is the source language of the binary? (go, c or c++)"
  read -rp "[go]: " SOURCE_LANG; SOURCE_LANG="${SOURCE_LANG:-go}"
fi; export SOURCE_LANG

# 0b. Go compiler (if applicable)
if [[ "${SOURCE_LANG,,}" == "go" && -z "$COMPILER" ]]; then
  echo ""; echo "Which Go compiler was used? (gc / tinygo)"
  read -rp "[gc]: " COMPILER; COMPILER="${COMPILER:-gc}"
fi; export COMPILER

# 0c. Thread scheduling for Go GC binaries
if [[ "${SOURCE_LANG,,}" == "go" && "${COMPILER,,}" == "gc" && -z "$THREAD_SCHEDULING" ]]; then
  echo ""; echo "Thread scheduling strategy for Go GC binary:"
  echo "  - all-threads: Explore multiple goroutines with cooperative scheduling at function calls (recommended for concurrency bugs)"
  echo "  - main-only: Only execute the main thread (faster, but may miss concurrency issues)"
  read -rp "[all-threads]: " THREAD_SCHEDULING; THREAD_SCHEDULING="${THREAD_SCHEDULING:-all-threads}"
fi; export THREAD_SCHEDULING
[[ "$INTERACTIVE_MODE" == "true" ]] && divider

ENTRY_POINT=$(get_entry_point "$BIN_PATH")

# 1. Mode
if [[ -z "$MODE" ]]; then
  echo ""; echo "Where to begin the analysis? (start / main / function / advanced)"
  read -rp "[main]: " MODE; MODE="${MODE:-main}"
fi

# 2. Address selection
case "$MODE" in
  start)
    [[ -z "$ADDR" ]] && ADDR="$ENTRY_POINT"
    [[ "$INTERACTIVE_MODE" == "true" ]] && echo -e "${GREEN}Entry point: $ADDR${RESET}" ;;
  main)
    if [[ -z "$ADDR" ]]; then
      ADDR=$(get_main_addr "$BIN_PATH")
      [[ -z "$ADDR" ]] && { echo "Could not locate main"; exit 1; }
      [[ "$INTERACTIVE_MODE" == "true" ]] && echo -e "${GREEN}Main address (auto-detected): $ADDR${RESET}"
    else
      [[ "$INTERACTIVE_MODE" == "true" ]] && echo -e "${GREEN}Main address (user-supplied): $ADDR${RESET}"
    fi
    ;;
  function|advanced)
    while [[ -z "$ADDR" ]]; do
      echo ""; read -rp "At what address should the analysis begin? (hex e.g. 0x123): " ADDR
      [[ "$ADDR" =~ ^0x[0-9a-fA-F]+$ || "$ADDR" =~ ^[0-9]+$ ]] || ADDR=""
    done ;;
  *)
    echo "Unknown mode: $MODE"; exit 1 ;;
esac

# Validate that the address is a valid instruction boundary.
# Disassembles from 64 bytes before the target to let x86 decode resynchronize,
# then checks if the natural instruction stream produces an instruction at the
# exact target address.
validate_instruction_boundary() {
  local addr="$1" bin="$2"
  local addr_decimal
  addr_decimal=$(printf "%d" "$addr" 2>/dev/null) || return 1

  local addr_hex_lower
  addr_hex_lower=$(printf "%x" "$addr_decimal")

  local range_start=$((addr_decimal - 64))
  [[ $range_start -lt 0 ]] && range_start=0
  local range_end=$((addr_decimal + 16))

  local disasm
  disasm=$(objdump -d --start-address="$range_start" --stop-address="$range_end" "$bin" 2>/dev/null)

  if echo "$disasm" | grep -qiE "^[[:space:]]*0*${addr_hex_lower}:"; then
    return 0
  else
    return 1
  fi
}

if [[ "$MODE" == "function" || "$MODE" == "advanced" ]] && [[ -n "$ADDR" ]]; then
  if ! validate_instruction_boundary "$ADDR" "$BIN_PATH"; then
    echo ""
    echo -e "\033[31m${BOLD}ERROR: Address $ADDR is not a valid instruction boundary.${RESET}"
    echo ""
    echo "  The address you provided falls in the middle of a multi-byte instruction."
    echo "  GDB cannot set a breakpoint here — it would corrupt the instruction and"
    echo "  cause the program to behave incorrectly (wrong branch, crash, or silent exit)."
    echo ""
    echo "  Use objdump to find valid instruction addresses near your target:"
    echo "    objdump -d --start-address=$ADDR $BIN_PATH | head -20"
    echo ""

    # Show nearby valid instructions (skip int3/nop padding to give useful context)
    _addr_dec=$(printf "%d" "$ADDR" 2>/dev/null)
    _range_start=$((_addr_dec - 16))
    [[ $_range_start -lt 0 ]] && _range_start=0
    _range_end=$((_addr_dec + 64))
    nearby=$(objdump -d --start-address="$_range_start" --stop-address="$_range_end" "$BIN_PATH" 2>/dev/null \
      | grep -E "^[[:space:]]*[0-9a-f]+:" | grep -v "int3\|\.byte\|nop$" | head -10)

    if [[ -n "$nearby" ]]; then
      echo "  Nearby valid instruction addresses:"
      echo "$nearby" | while IFS= read -r line; do echo "    $line"; done
      echo ""
    fi

    exit 1
  fi
fi

# 2b. Advanced mode: symbolic registers and memory
GP_REGISTERS="RAX RCX RDX RBX RSP RBP RSI RDI R8 R9 R10 R11 R12 R13 R14 R15"

expand_registers() {
  local input="$1"
  local upper="${input^^}"
  if [[ "$upper" == "ALL" ]]; then
    echo "$GP_REGISTERS"
  else
    echo "$input"
  fi
}

validate_registers() {
  local input="$1"
  [[ "$input" == "none" || -z "$input" ]] && return 0
  local has_error=false
  for reg in $input; do
    local upper="${reg^^}"
    local found=false
    for valid in $GP_REGISTERS; do
      [[ "$upper" == "$valid" ]] && { found=true; break; }
    done
    if [[ "$found" == "false" ]]; then
      echo -e "  \033[31mUnknown register '${reg}'. Valid registers: $GP_REGISTERS, or 'all'\033[0m"
      has_error=true
    fi
  done
  [[ "$has_error" == "true" ]] && return 1
  return 0
}

validate_memory_ranges() {
  local input="$1"
  [[ "$input" == "none" || -z "$input" ]] && return 0
  local has_error=false
  for spec in $input; do
    if [[ ! "$spec" =~ ^0x[0-9a-fA-F]+:[0-9]+$ ]]; then
      echo -e "  \033[31mInvalid memory range '${spec}'. Expected format: 0xADDR:SIZE (e.g. 0x7fff0010:8)\033[0m"
      has_error=true
    fi
  done
  [[ "$has_error" == "true" ]] && return 1
  return 0
}

if [[ "$MODE" == "advanced" ]]; then
  [[ "$INTERACTIVE_MODE" == "true" ]] && divider

  # --- Symbolic registers ---
  if [[ -z "$SYMBOLIC_REGISTERS" ]]; then
    while true; do
      echo ""
      echo "Which registers do you want to make symbolic? (space-separated, e.g. RAX RDI RSI, 'all', or 'none')"
      read -rp "[none]: " SYMBOLIC_REGISTERS; SYMBOLIC_REGISTERS="${SYMBOLIC_REGISTERS:-none}"
      SYMBOLIC_REGISTERS=$(expand_registers "$SYMBOLIC_REGISTERS")
      validate_registers "$SYMBOLIC_REGISTERS" && break
      SYMBOLIC_REGISTERS=""
    done
  else
    SYMBOLIC_REGISTERS=$(expand_registers "$SYMBOLIC_REGISTERS")
    if ! validate_registers "$SYMBOLIC_REGISTERS"; then
      echo ""
      echo -e "\033[31m${BOLD}ERROR: Invalid register name(s) in --symbolic-registers.${RESET}"
      echo "  Valid registers: $VALID_REGISTERS"
      exit 1
    fi
  fi

  # --- Symbolic memory ---
  if [[ -z "$SYMBOLIC_MEMORY" ]]; then
    while true; do
      echo ""
      echo "Which memory addresses do you want to make symbolic? (format: 0xADDR:SIZE_BYTES, space-separated, or 'none')"
      echo "  Example: 0x7fff0010:8 0x404000:16"
      read -rp "[none]: " SYMBOLIC_MEMORY; SYMBOLIC_MEMORY="${SYMBOLIC_MEMORY:-none}"
      validate_memory_ranges "$SYMBOLIC_MEMORY" && break
      SYMBOLIC_MEMORY=""
    done
  else
    if ! validate_memory_ranges "$SYMBOLIC_MEMORY"; then
      echo ""
      echo -e "\033[31m${BOLD}ERROR: Invalid memory range format in --symbolic-memory.${RESET}"
      echo "  Expected format: 0xADDR:SIZE_BYTES (e.g. 0x7fff0010:8 0x404000:16)"
      exit 1
    fi
  fi

fi
[[ "$INTERACTIVE_MODE" == "true" ]] && divider

# 3. Runtime arguments
if [[ "$ARGS_SET" == "false" ]]; then
  echo ""; echo "Does the binary expect any arguments? (none / e.g., x y z)"
  read -rp "[none]: " ARGS; ARGS="${ARGS:-none}"
fi
[[ "$INTERACTIVE_MODE" == "true" ]] && divider

# 4. Negate path exploration
if [[ -z "$NEGATE_PATH_FLAG" ]]; then
  echo ""; echo "Do you want to activate the negating path execution to cover symbolically more paths?"
  read -rp "[Y/n]: " ENABLE_NEGATING; ENABLE_NEGATING="${ENABLE_NEGATING,,}"
  if [[ "$ENABLE_NEGATING" == "n" || "$ENABLE_NEGATING" == "no" ]]; then
    NEGATE_PATH_FLAG="false"
  else
    NEGATE_PATH_FLAG="true"
  fi
fi
[[ "$INTERACTIVE_MODE" == "true" ]] && divider

# 5. Plugin selection
if [[ -z "$PLUGINS" ]]; then
  VALID_PLUGINS="none volos toctou chancheck all"
  while true; do
    echo ""; echo "Which plugin(s) do you want to activate? (none / volos / toctou / chancheck / all)"
    echo "  - none: No plugins (pure concolic execution)"
    echo "  - volos: Data-race detector"
    echo "  - toctou: Time-of-check-time-of-use detector"
    echo "  - chancheck: Send-on-closed-channel detector (Go)"
    echo "  - all: Enable all plugins"
    echo "  Combine with spaces, e.g.: volos toctou"
    read -rp "[all]: " PLUGINS; PLUGINS="${PLUGINS:-all}"

    PLUGINS_VALID=true
    for p in $PLUGINS; do
      if ! echo "$VALID_PLUGINS" | grep -qw "$p"; then
        echo ""; echo "  Unknown plugin '$p'. Valid options: $VALID_PLUGINS"
        PLUGINS_VALID=false
        PLUGINS=""
        break
      fi
    done
    [[ "$PLUGINS_VALID" == "true" ]] && break
  done
fi
[[ "$INTERACTIVE_MODE" == "true" ]] && divider

##############################################################################
#                        ENV EXPORTS & FINAL COMMAND
##############################################################################

export MODE ARGS START_POINT="$ADDR" ZORYA_DIR BIN_PATH NEGATE_PATH_FLAG="$NEGATE_PATH_FLAG" FORCE_PTY
export SYMBOLIC_REGISTERS SYMBOLIC_MEMORY
export ZORYA_PLUGINS="$PLUGINS"

# Build final command string (using original path for display, but actual execution uses absolute)
CMD="$ZORYA_DIR/zorya $BIN_PATH_ORIGINAL --mode $MODE"
[[ -n "$ADDR" ]] && CMD+=" $ADDR"
[[ -n "$SOURCE_LANG" ]] && CMD+=" --lang $SOURCE_LANG"
[[ -n "$COMPILER" ]] && CMD+=" --compiler $COMPILER"
[[ -n "$THREAD_SCHEDULING" ]] && CMD+=" --thread-scheduling $THREAD_SCHEDULING"
[[ "$ARGS" != "none" ]] && CMD+=" --arg \"$ARGS\""
if [[ -n "$SYMBOLIC_REGISTERS" && "$SYMBOLIC_REGISTERS" != "none" ]]; then
  CMD+=" --symbolic-registers \"$SYMBOLIC_REGISTERS\""
else
  CMD+=" --no-symbolic-registers"
fi
if [[ -n "$SYMBOLIC_MEMORY" && "$SYMBOLIC_MEMORY" != "none" ]]; then
  CMD+=" --symbolic-memory \"$SYMBOLIC_MEMORY\""
else
  CMD+=" --no-symbolic-memory"
fi
[[ "$NEGATE_PATH_FLAG" == "true" ]] && CMD+=" --negate-path-exploration" || CMD+=" --no-negate-path-exploration"
[[ -n "$PLUGINS" && "$PLUGINS" != "none" ]] && CMD+=" --plugin \"$PLUGINS\""
[[ "$FORCE_PTY" == "true" ]] && CMD+=" --force-pty"

echo "*************************************************************************************"
echo "Running command: $CMD"
echo ""
export ZORYA_CMD="$CMD"

# Step 1: Pcode generation
cd "$PCODE_GENERATOR_DIR" || exit 1
# Pin CARGO_TARGET_DIR so pcode_generator (which derives its output dir from
# current_exe()) writes results into $PCODE_GENERATOR_DIR/results/ even when
# the surrounding env injects a different CARGO_TARGET_DIR
# (e.g. Cursor's /tmp/cursor-sandbox-cache/...).
CARGO_TARGET_DIR="$PCODE_GENERATOR_DIR/target" \
  RUSTFLAGS="--cap-lints=allow" cargo run --release "$BIN_PATH" --low-pcode

PCODE_FILE="$PCODE_GENERATOR_DIR/results/$(basename "$BIN_PATH")_low_pcode.txt"
[[ ! -f "$PCODE_FILE" ]] && { echo "Pcode generation failed."; exit 1; }

# Step 2: Generate dumps
echo ""; echo "Generating memory and CPU register dumps…"
chmod +x "$ZORYA_DIR/scripts/dump_memory.sh"
if ! "$ZORYA_DIR/scripts/dump_memory.sh" "$BIN_PATH" "$ADDR" "$ENTRY_POINT" "$ARGS"; then
  echo ""
  echo -e "\033[31m${BOLD}Zorya cannot continue without valid memory and CPU dumps. Aborting.${RESET}"
  exit 1
fi

# Step 2.5: Extract and analyze VDSO
echo ""; echo "Extracting VDSO from process memory…"
chmod +x "$ZORYA_DIR/scripts/extract_vdso.sh"
"$ZORYA_DIR/scripts/extract_vdso.sh" "$BIN_PATH" "$ADDR" "$ARGS"

if [[ -f "$INIT_DATA_DIR/vdso/vdso.so" && -s "$INIT_DATA_DIR/vdso/vdso.so" && -f "$INIT_DATA_DIR/vdso/vdso_base_addr.txt" ]]; then
  VDSO_BASE=$(cat "$INIT_DATA_DIR/vdso/vdso_base_addr.txt" | tr -d '[:space:]')
  if [[ -n "$VDSO_BASE" && "$VDSO_BASE" =~ ^0x[0-9a-fA-F]+$ ]]; then
    echo ""; echo "Generating p-code for VDSO (base: $VDSO_BASE)…"
    chmod +x "$ZORYA_DIR/scripts/generate_vdso_pcode.sh"
    "$ZORYA_DIR/scripts/generate_vdso_pcode.sh" "$INIT_DATA_DIR/vdso/vdso.so" "$VDSO_BASE"
  else
    echo "⚠ Warning: VDSO base address is empty or invalid ('$VDSO_BASE'), continuing without VDSO support"
  fi
else
  echo "⚠ Warning: VDSO extraction failed or produced empty output, continuing without VDSO support"
fi

# Step 3: Run Zorya core
echo ""; 
echo "*********************************************************************************************"
echo "Completed the generation of memory and CPU register dumps, and the P-Code file of the binary."
echo "Launching Zorya now..."
echo "*********************************************************************************************"
echo ""

cd "$ZORYA_DIR" || exit 1
# Same reasoning as the pcode_generator invocation above: pin CARGO_TARGET_DIR
# so artifacts land inside the workspace.
CARGO_TARGET_DIR="$ZORYA_DIR/target" \
  RUSTFLAGS="--cap-lints=allow" cargo run --release -- --write-args "$ARGS"
